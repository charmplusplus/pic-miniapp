mainmodule prk {

//include "prk.h";
readonly CProxy_Main	mainProxy;
readonly CProxy_Cell  cellProxy;
readonly  int64_t     T ;
readonly int64_t     	g ;   // dimension of grid
readonly int 		chare_dim_x;
readonly int 		chare_dim_y;
readonly int64_t	per_chare_x;
readonly int64_t  	per_chare_y;
readonly int64_t  	per_chare_edge_x;
readonly int64_t  	per_chare_edge_y;
readonly int  	removal_mode ;
readonly int  	injection_mode ;
readonly int  	injection_timestep;
readonly int  	removal_timestep;
readonly int  	corner_top_left_x_inj;
readonly int  	corner_bottom_right_x_inj;
readonly int  	corner_top_left_y_inj;
readonly int  	corner_bottom_right_y_inj;
readonly int  	corner_top_left_x_rmv;
readonly int  	corner_bottom_right_x_rmv;
readonly int  	corner_top_left_y_rmv;
readonly int  	corner_bottom_right_y_rmv;
readonly int         	particles_per_cell;
readonly int         	k ;   // determines the speed of "horizontal move" of the particle distribution -- (2*k)+1 cells per time step
readonly int         	m ;   // determines the speed of "vertical move" of the particle distribution -- m cells per time step
readonly int         	lb_period;
readonly int			striped; // striped decomposition flag

mainchare Main {
	entry Main(CkArgMsg* m);
    	entry [reductiontarget] void completed(int result);
    	entry [reductiontarget] void validation(long result);
    	entry [reductiontarget] void statistics(double result[n], int n);
    	entry [reductiontarget] void avg_stats(double result[n], int n);
    	entry void done_initialization();	
    	entry void liveViz_support() {
    	  for(itr=0;itr<chare_dim_x * chare_dim_y;itr++) {
    	    when done_initialization() serial {;}
    	  }
    	  
    	  serial {
			time_start= CkWallTimer();
			cellProxy.beginIterations();
    	  }
    	};
};

array [2D] Cell {
	entry Cell(void);
	entry void colorRegion(liveVizRequestMsg *m);
	entry void initializeParticles(std::vector<particle_t> incoming);
	entry void beginIterations();
	entry void receiveParticles(int time,std::vector<particle_t> incoming);
	entry void ResumeFromSync();
	entry [reductiontarget] void callAtSync();
	entry void start_comm();
	entry void compute_completed(double result[n], int n);
	entry void comm_completed(double result[n], int n);
	entry void comm_done();
	entry void lb_completed(double result[n], int n);
	entry void done_lb();

	entry void run() {
		when initializeParticles(std::vector<particle_t> incoming)
		serial
		{
			//if(x_cord==4 && y_cord==1)
			//CkPrintf("%d %d : Received particles of size %d \n",x_cord,y_cord,incoming.size());
			particles=incoming;
			mainProxy.done_initialization();
		}

		when beginIterations() serial {
			//Now the particles vector is populated
			
			simulation_time = CkWallTimer(); // start chare timer
		}
		for(time=0; time<T; time++){
			serial{
				old_particle_count=particles.size();
				communicated_particles=0;
				iteration_time_start = CkWallTimer();
			}
			if (injection_mode && (time == injection_timestep))
			serial {
				inject_particles(injection_timestep, corner_top_left_x_inj, corner_bottom_right_x_inj, corner_top_left_y_inj, corner_bottom_right_y_inj, particles_per_cell, particles, my_start_gp_x, my_end_gp_x, my_start_gp_y, my_end_gp_y);
			}
			if (removal_mode && (time == removal_timestep))
			serial  {
				remove_particles_and_validate(removal_timestep, corner_top_left_x_rmv, corner_bottom_right_x_rmv, corner_top_left_y_rmv, corner_bottom_right_y_rmv, particles, &partial_correctness, grid, g, k, m, L, T);
			}
			
			serial {
				computation_time_start = CkWallTimer();
				compute_displacement_forces();
				computation_time_end = CkWallTimer();

				if (_lb_args.debug() == -1) {
					double comp_time[3];
					comp_time[0] = computation_time_start;
					comp_time[1] = computation_time_end;
					comp_time[2] = CkMyPe();
					cellProxy(0,0).compute_completed(comp_time, 3);
				} else {
					// do nothing
					sendParticles();
				}
			}
			if (_lb_args.debug() == -1) {
				when start_comm() serial {
					comm_time_start = CkWallTimer();
					sendParticles();
				}
			}
			for(noNeighbours=0;noNeighbours<NEIGHBORS;noNeighbours++)
			{
				when receiveParticles[time](int time, std::vector<particle_t> incoming) 
				serial 
				{
					particles.insert(particles.end(),incoming.begin(),incoming.end());
					communicated_particles += incoming.size();
				}
			}
			if (_lb_args.debug() == -1) {
				serial{
					comm_time_end = CkWallTimer();
				double comm_time[3];
					comm_time[0] = comm_time_start;
					comm_time[1] = comm_time_end;
					comm_time[2] = CkMyPe();
					cellProxy(0,0).comm_completed(comm_time, 3);
				}
			}
			if(_lb_args.debug() == -1){ 
				when comm_done() serial{ 
					;}
				}
			serial{ 
				double stop_time = CkWallTimer();
				double iteration_time = stop_time - iteration_time_start;

				double computation_time = computation_time_end - computation_time_start;
				double communication_time = iteration_time - computation_time;

				//CkPrintf("TIME DATA---%d, %d, %d, %lf, %lf, %lf, %d\n", time, x_cord, y_cord, computation_time, communication_time, iteration_time, particles.size());

				if (time >= iteration_times.size()) {
					CkAbort("Error: time %d exceeds iteration_times size %d on chare (%d,%d)\n", time, iteration_times.size(), x_cord, y_cord);
				}
				iteration_times[time] = communication_time;//particles.size();//stop_time - iteration_time_start;

				if (old_particle_count + communicated_particles != particles.size()) {
					// add the communication that I sent away
					communicated_particles += std::abs(old_particle_count + communicated_particles - particles.size());
				}
				
				iteration_percent_variation[time] = communicated_particles;
				
				int chare_id = thisIndex.x + thisIndex.y * chare_dim_x;
				//CkPrintf("SHEET DATA---%d, %d, %d, %d, %d, %d\n", time, chare_id, CkMyPe(), thisIndex.x, thisIndex.y, particles.size());
			
			}
			if ((time % lb_period) == lb_period-1) {
				serial{
					lb_start_time = CkWallTimer();
					contribute(CkCallback(CkReductionTarget(Cell, callAtSync), thisProxy));
				}
				when ResumeFromSync() serial {
					lb_end_time = CkWallTimer();
				}

				if (_lb_args.debug() == -1) {
					// contribute lb times
					serial{
						double lb_time[3];
						lb_time[0] = lb_start_time;
						lb_time[1] = lb_end_time;
						lb_time[2] = CkMyPe();
						cellProxy(0,0).lb_completed(lb_time, 3);
					}
					when done_lb() serial{}
				}
			}
		}
	
		
		serial {
			simulation_time=CkWallTimer()-simulation_time;
			compute_correctness();
		}
		
	};
};

 group Grid2DMap : CkArrayMap
  {
    entry Grid2DMap(int xdim, int ydim, int xprocs, int yprocs);
  };
};

